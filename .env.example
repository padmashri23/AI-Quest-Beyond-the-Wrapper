# Lyzr Agent Studio — https://studio.lyzr.ai  (leave blank to run in rules-only fallback mode)
LYZR_API_KEY=
# LYZR_DISABLED=true  # explicit offline mode, even if credentials are present
# LYZR_TOOL_TOKEN=    # optional 32+ character bearer token for hosted deterministic tools
LYZR_CLASSIFIER_AGENT_ID=
LYZR_WRITER_AGENT_ID=
LYZR_USER_ID=carbon-copilot@yourcompany.com
# Optional overrides
# LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
# LYZR_API_BASE=https://agent-prod.studio.lyzr.ai
# LYZR_LLM_CREDENTIAL_ID=lyzr_openai

# Backend
# Use production only behind an HTTPS reverse proxy, with externally managed keys.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# DATA_ENCRYPTION_KEY=   # 32-byte URL-safe base64 key; required in production
# AUDIT_SIGNING_KEY=     # separate 32-byte URL-safe base64 key; required in production
# BACKUP_ENCRYPTION_KEY= # third independent key for encrypted backup archives
# Use either KEY or KEY_FILE, never both. Secret files contain one base64 key.
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_key
# AUDIT_SIGNING_KEY_FILE=/run/secrets/audit_key
# BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_key
# ALLOWED_HOSTS=carbon.example.com  # required in production; no wildcard
# KEY_DIR=./backend/data/.keys
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# LEDGER_PATH=./backend/data/ledger.db
# FRONTEND_DIST=./frontend/dist

# Frontend dev server proxy target (only for `npm run dev`)
# VITE_API_TARGET=http://localhost:8000

# compose.production.yml preparation (hosting and DNS are deliberately not chosen)
# COPILOT_DOMAIN=carbon.example.com
# ACME_EMAIL=operations@example.com
# DATA_KEY_FILE=/absolute/private/path/data_key
# AUDIT_KEY_FILE=/absolute/private/path/audit_key
# BACKUP_KEY_FILE=/absolute/private/path/backup_key
